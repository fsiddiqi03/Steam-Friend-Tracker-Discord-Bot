# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
#   New Application -> Bot -> Reset Token
# No privileged intents are required; the bot only posts messages.
DISCORD_TOKEN=

# Channel to post in. Enable Developer Mode in Discord
# (Settings -> Advanced), then right-click the channel -> Copy Channel ID.
# The bot needs View Channel, Send Messages and Embed Links there.
DISCORD_CHANNEL_ID=

# --- Steam -----------------------------------------------------------------
# API key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY= 

# Your own SteamID64 (17 digits). Only used by the gen_friends helper to read
# your friends list; the bot itself does not need it.
STEAM_ID=

# --- Behaviour (all optional) ----------------------------------------------
# Seconds between Steam polls. Minimum 5.
POLL_INTERVAL_SECONDS=15

# Hours in one game before a "no movement detected" alert fires. It repeats at
# each multiple, so a 12-hour session gets called out three times.
MARATHON_HOURS=4

# Path to the tracked-friends file.
FRIENDS_FILE=friends.json

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# --- Supabase --------------------------------------------------------------
# Project URL and the service_role (secret) key from
# https://supabase.com/dashboard/project/kamrvulkfxbudntfthjt/settings/api-keys
# Must be service_role, not the publishable/anon key -- RLS is on with no
# policies, so anon can neither read nor write. Never commit the real value.
SUPABASE_URL=https://kamrvulkfxbudntfthjt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
